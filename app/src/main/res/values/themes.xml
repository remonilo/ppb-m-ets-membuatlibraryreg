<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LibraryReg" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_tint</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- Induk kosong untuk gaya LibraryReg.* yang tidak punya parent eksplisit (Label, Body). -->
    <style name="LibraryReg" />

    <style name="LibraryReg.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="LibraryReg.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="LibraryReg.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="LibraryReg.Label">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LibraryReg.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="LibraryReg.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="LibraryReg.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <style name="LibraryReg.Button.Danger" parent="LibraryReg.Button">
        <item name="backgroundTint">@color/error</item>
    </style>
</resources>
